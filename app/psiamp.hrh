	{
	EPaCmdOpenFile = 0x1000,
	EPaCmdOpenFolder,
	EPaCmdAddFile,
	EPaCmdAddFolder,
	EPaCmdSavePlaylist,
	EPaCmdRemove,
	EPaCmdClear,
